DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.bongochee.co.tz
POSTGRES_DB=bongochee
POSTGRES_USER=bongochee_user
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
# "Lax" works when frontend and backend share a site (same domain, or same registrable
# domain via subdomains). Set to "None" when they're on different hosts entirely — e.g.
# two separate Render services, each on its own onrender.com subdomain — otherwise the
# browser never sends the auth cookie back and login appears to silently fail.
COOKIE_SAMESITE=Lax
# Optional bot protection on login — leave blank to disable. Get a free secret key at
# https://dash.cloudflare.com/?to=/:account/turnstile (pair with VITE_TURNSTILE_SITE_KEY
# in frontend/.env — see frontend/.env.example).
TURNSTILE_SECRET_KEY=
# Required by seed_data.py to create/reset the "super" (Django superuser) and
# "admin" (system-role) accounts. Pick strong, unique values — never commit real
# ones here, this file is the template, not the real config.
SEED_SUPER_PASSWORD=
SEED_ADMIN_PASSWORD=
